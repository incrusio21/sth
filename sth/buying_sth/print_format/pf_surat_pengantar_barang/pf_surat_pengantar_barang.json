 "css": ".page-break {\n    padding: 0;\n    margin: 0;\n}\n\n* {\n    font-size: 13px !important;\n}\n\n.head_table_item {\n    background-color: #acacac; \n    border: 1px solid #000; \n    vertical-align: middle!important; \n    text-align: center;\n}\n\n.ttd_line {\n    width: 10rem !important;\n    height: 1px !important;\n    display: inline-block;\n    border-bottom: 2px dotted #000;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Purchase Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set website_settings = frappe.get_doc(\"Website Settings\") %}\n\n<div class=\"page-break\">\n    <div>\n        {% set is_service = doc.sub_purchase_type == 'Service Request' %}\n        \n        <h4 class=\"text-center\" style=\"font-size: 1.5rem!important;\">\n            Surat Pengantar Barang\n        </h4>\n\n        <!--<h4 class=\"text-center\">-->\n        <!--    {{ \"Service Order\" if is_service else \"Purchase Order\" }}-->\n        <!--</h4>-->\n        <!--<h4 class=\"text-center\">-->\n        <!--    {{ \"SO\" if is_service else \"PO\" }}-->\n        <!--</h4>-->\n    </div>\n    <img src=\"{{ website_settings.app_logo }}\" style=\"height: 5rem; object-fit: contain;\"/>\n    <table style=\"width: 100%;\">\n        <tr>\n            <td style=\"padding-left: 0!important;\">\n                {{ doc.lokasi_pengiriman or '' }} -\n                {{ doc.alamat or '' }}\n            </td>\n            <td style=\"width: 60%;\">\n                <table style=\"width: 100%;\">\n                    <tr>\n                        <td style=\"padding-top: 0!important; white-space: nowrap;\">PO. NO.</td>\n                        <td style=\"padding-top: 0!important;\">{{doc.name or '-'}}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important;\">Date</td>\n                        <td style=\"padding-top: 0!important;\">{{frappe.utils.getdate(doc.transaction_date).strftime(\"%d %B %Y\")}}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important;\">T.O.P</td>\n                        <td style=\"padding-top: 0!important;\">{{ doc.syarat_pembayaran or '' }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important;\" colspan=\"2\">Invoice Address and Tax Invoice</td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n    <div style=\"width: 100%; height: 2px; background-color: #000;\"></div>\n    <table>\n        <tr>\n            <td style=\"width: 50%; padding-left: 0!important; text-align: justify;\">\n                Suplier/Sender : <br/>\n                {% set supplier = frappe.get_doc(\"Supplier\", doc.supplier) %}\n                \n                {{ supplier.supplier_name }} <br/>\n                {{ supplier.alamat_dan_pic_supplier[0].alamat_pic or '' }} <br/>\n                {{ supplier.alamat_dan_pic_supplier[0].kota_pic or '' }} <br/>\n                NPWP {{ supplier.npwp_dan_sppkp_supplier[0].no_npwp or '' }} <br/>\n                Telp/Fax {{ supplier.alamat_dan_pic_supplier[0].telp or '' }} / {{ supplier.alamat_dan_pic_supplier[0].fax or '' }} <br/>\n                Attn {{ supplier.alamat_dan_pic_supplier[0].kontak_person or '' }}\n            </td>\n            <td style=\"width: 50%; text-align: justify;\">\n                Standard Tax Invoice, under the name of : <br/>\n                {% set company = frappe.get_doc(\"Company\", doc.company) %}\n                \n                {{ company.name or '' }} <br/>\n                {{ company.company_description or '' }} <br/>\n                NPWP: {{ company.npwp or '' }}\n            </td>\n        </tr>\n    </table>\n    <div style=\"border: 1px solid #000; border-bottom: 0; padding: 0.5rem;\">\n        <p style=\"text-align: justify;\">\n            Terima kasih untuk tidak memberikan segala macam bentuk gratifikasi kepada karyawan {{ doc.company or '' }}. Perusahaan tidak pernah\n            meminta karyawan untuk meminta pengembalian dana secara tunai apabila ada pembatalan PO (Purchase Order). <br/> <br/>\n            Perusahaan akan terminasi kerjasama dengan Supplier (Business Partner) {{ doc.company or '' }} jika ditemukan pelanggaran tersebut. <br/> <br/>\n            Untuk konfirmasi PO (Purchase Order) apabila ada pembatalan dapat menghubungi Head Office di No. Telp (021) 5011-1292, 5011-1290 atau melalui\n            email procurement@sthgroup.com, inventory-dept@agro.sthgroup.com dan tjho.tre03@sthgroup.com\n        </p>\n    </div>\n    <table>\n        <tr>\n            <td class=\"head_table_item\">No</td>\n            <td class=\"head_table_item\" colspan=\"2\">SPECIFICATION</td>\n            <td class=\"head_table_item\">NEGARA BUATAN</td>\n            <td class=\"head_table_item\">QUANTITY</td>\n        </tr>\n        {%- for row in doc.items -%}\n            <tr>\n                <td style=\"border: 1px solid #000;\">{{ row.idx }}</td>\n                <td style=\"border: 1px solid #000;\">{{ row.item_name }}</td>\n                <td style=\"border: 1px solid #000; text-align: justify;\">{{ row.description }}</td>\n                <td style=\"border: 1px solid #000;\">{{ row.custom_country }}</td>\n                <td style=\"border: 1px solid #000;\">{{ row.qty }} {{ row.uom }}</td>\n            </tr>\n        {%- endfor -%}\n    </table>\n    <table class=\"mt-4\" style=\"width: 100%;\">\n        <tr>\n            <td style=\"border: 1px solid #000; width: 60%;\">\n                Term & Condition\n                <table style=\"width: 100%;\" class=\"mt-2\">\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">1.</td>\n                        <td style=\"padding-top: 0!important;\">Delivery Type</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">{{ doc.lokasi_pengiriman or '' }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">2.</td>\n                        <td style=\"padding-top: 0!important;\">Term of Payment</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">{{ doc.syarat_pembayaran or '' }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">3.</td>\n                        <td style=\"padding-top: 0!important;\">Price</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">IDR</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">4.</td>\n                        <td style=\"padding-top: 0!important;\">Delivery Time</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">Sebelum Tanggal {{frappe.utils.getdate(doc.waktu_penyerahan or '').strftime(\"%d %B %Y\")}}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">5.</td>\n                        <td style=\"padding-top: 0!important;\">No Refrensi</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\"></td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">6.</td>\n                        <td style=\"padding-top: 0!important;\">Ref PR</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">\n                            {{ doc.items | map(attribute=\"material_request\") | join(\", \") }}\n                        </td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">7.</td>\n                        <td style=\"padding-top: 0!important;\">Ref Quotation</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">\n                            {{ doc.items | map(attribute=\"supplier_quotation\") | join(\", \") }}\n                        </td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">8.</td>\n                        <td style=\"padding-top: 0!important;\">Kindly liase with logistic Officer</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">\n                            {{ doc.owner or '' }}\n                        </td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">9.</td>\n                        <td style=\"padding-top: 0!important;\">Delivery To</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important; text-align: justify;\">{{ doc.alamat or '' }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important; padding-left: 0!important;\">10.</td>\n                        <td style=\"padding-top: 0!important;\">Keterangan</td>\n                        <td style=\"padding-top: 0!important;\">:</td>\n                        <td style=\"padding-top: 0!important;\">{{ doc.keterangan or '' }}</td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n    <table style=\"width: 100%!important; margin-top: 1rem;\">\n        <tr>\n            <td style=\"text-align: center; float: left; padding-left: 0!important;\">\n                <span style=\"display: block; margin-bottom: 5rem;\">Issued by</span>\n                (<div class=\"ttd_line\"></div>)\n                <span style=\"display: block;\">Staff</span>\n            </td>\n            <td style=\"text-align: center; float: right; padding-right: 0!important;\">\n                <span style=\"display: block; margin-bottom: 5rem;\">Approved</span>\n                (<div class=\"ttd_line\"></div>)\n                <span style=\"display: block;\">RUSMIN WIJAYA <br/> Release : {{frappe.utils.getdate(frappe.utils.today()).strftime(\"%d %B %Y\")}}</span>\n            </td>\n        </tr>\n    </table>\n</div>",
