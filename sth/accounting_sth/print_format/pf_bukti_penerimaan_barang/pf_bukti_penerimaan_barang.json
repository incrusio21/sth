 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set website_settings = frappe.get_doc(\"Website Settings\") %}\n\n<div class=\"page-break\">\n    <div>\n        {% set is_service = doc.sub_purchase_type == 'Service Request' %}\n        \n        <h4 class=\"text-center\" style=\"font-size: 1.5rem!important;\">\n            Bukti Penerimaan Barang\n        </h4>\n\n        <!--<h4 class=\"text-center\">-->\n        <!--    {{ \"Service Order\" if is_service else \"Purchase Order\" }}-->\n        <!--</h4>-->\n        <!--<h4 class=\"text-center\">-->\n        <!--    {{ \"SO\" if is_service else \"PO\" }}-->\n        <!--</h4>-->\n    </div>\n    <img src=\"{{ website_settings.app_logo }}\" style=\"height: 5rem; object-fit: contain;\"/>\n    <table style=\"width: 100%;\">\n        <tr>\n            <td style=\"padding-left: 0!important;\">\n                PABRIK - BANYUASIH </br>\n                Desa Kerta Jaya, Kec. Sumur, Kab. Pandeglang\n            </td>\n            <td style=\"width: 60%;\"> \n                <table style=\"width: 100%;\">\n                    <tr>\n                        <td style=\"padding-top: 0!important;\">Purchase Receipt No.</td>\n                        <td style=\"padding-top: 0!important;\">{{doc.name or '-'}}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding-top: 0!important;\">Date</td>\n                        <td style=\"padding-top: 0!important;\">{{frappe.utils.getdate(doc.transaction_date).strftime(\"%d %B %Y\")}}</td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n    <div style=\"width: 100%; height: 2px; background-color: #000;\"></div>\n    <table>\n        <tr>\n            <td style=\"width: 50%; padding-left: 0!important; text-align: justify;\">\n                Suplier/Sender : <br/>\n                {% set supplier = frappe.get_doc(\"Supplier\", doc.supplier) %}\n                \n                {{ supplier.supplier_name }} <br/>\n                {{ supplier.alamat_dan_pic_supplier[0].alamat_pic or '' }}\n            </td>\n            <td style=\"width: 50%; text-align: justify;\">\n                Standard Tax Invoice, under the name of : <br/>\n                {% set company = frappe.get_doc(\"Company\", doc.company) %}\n                \n                {{ company.name or '' }} <br/>\n                {{ company.company_description or '' }}\n            </td>\n        </tr>\n    </table>\n\n    <table>\n        <tr>\n            <td class=\"head_table_item\">No</td>\n            <td class=\"head_table_item\" colspan=\"2\">SPECIFICATION</td>\n            <td class=\"head_table_item\">NEGARA BUATAN</td>\n            <td class=\"head_table_item\">QUANTITY</td>\n        </tr>\n        {%- for row in doc.items -%}\n            <tr>\n                <td style=\"border: 1px solid #000;\">{{ row.idx }}</td>\n                <td style=\"border: 1px solid #000;\">{{ row.item_name }}</td>\n                <td style=\"border: 1px solid #000; text-align: justify;\">{{ row.description }}</td>\n                <td style=\"border: 1px solid #000;\">{{ row.custom_country }}</td>\n                <td style=\"border: 1px solid #000;\">{{ row.qty }} {{ row.uom }}</td>\n            </tr>\n        {%- endfor -%}\n    </table>\n    <table style=\"width: 100%!important; margin-top: 1rem;\">\n        <tr>\n            <td style=\"text-align: center; float: left; padding-left: 0!important;\">\n                <span style=\"display: block; margin-bottom: 5rem;\">Issued by</span>\n                (<div class=\"ttd_line\"></div>)\n                <span style=\"display: block;\">Staff</span>\n            </td>\n            <td style=\"text-align: center; float: right; padding-right: 0!important;\">\n                <span style=\"display: block; margin-bottom: 5rem;\">Approved</span>\n                (<div class=\"ttd_line\"></div>)\n                <span style=\"display: block;\">RUSMIN WIJAYA <br/> Release :</span>\n            </td>\n        </tr>\n    </table>\n</div>",
